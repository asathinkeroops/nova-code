{
  "name": "@asathinkeroops/nova-code",
  "version": "0.2.0",
  "description": "A terminal coding agent, deeply tuned for DeepSeek.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/asathinkeroops/nova-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asathinkeroops/nova-code.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/asathinkeroops/nova-code/issues"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "llm",
    "deepseek",
    "agent",
    "terminal"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nova": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "prepub": "pnpm publish --access public --tag beta --no-git-checks --registry=https://registry.npmjs.org/ && npm dist-tag add $npm_package_name@$npm_package_version latest --registry=https://registry.npmjs.org/",
    "release": "pnpm publish --access public --tag latest --no-git-checks --registry=https://registry.npmjs.org/",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.52",
    "@anthropic-ai/sdk": "^0.111.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.18.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.3",
    "get-east-asian-width": "^1.6.0",
    "ignore": "^5.3.2",
    "ink": "^5.0.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "react": "^18.3.0",
    "string-width": "^7.2.0",
    "unpdf": "^1.6.2",
    "wrap-ansi": "^9.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@nova/agent": "workspace:*",
    "@nova/context": "workspace:*",
    "@nova/core": "workspace:*",
    "@nova/external": "workspace:*",
    "@nova/lsp": "workspace:*",
    "@nova/observability": "workspace:*",
    "@nova/runtime": "workspace:*",
    "@nova/safety": "workspace:*",
    "@nova/sandbox": "workspace:*",
    "@nova/subagent": "workspace:*",
    "@nova/tools": "workspace:*",
    "@types/react": "^18.3.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2"
  }
}
